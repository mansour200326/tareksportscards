# ---------------------------------------------------------------------------
# Sanity CMS
# ---------------------------------------------------------------------------
# Found in your Sanity project settings (https://www.sanity.io/manage)
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
# Server-only write token with "Editor" permissions. Used by the Stripe
# webhook to decrement product quantity. NEVER expose this to the client.
SANITY_API_WRITE_TOKEN="your-write-token"

# ---------------------------------------------------------------------------
# Stripe
# ---------------------------------------------------------------------------
# From https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_xxx"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_xxx"
# From the Stripe webhook endpoint you create (whsec_...)
STRIPE_WEBHOOK_SECRET="whsec_xxx"

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
# Public base URL of the deployed site (no trailing slash).
# Locally this is http://localhost:3000
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
